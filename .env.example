# ---- 应用 ----
APP_NAME=广东地下演出日历
ENV=dev
DEBUG=true
TIMEZONE=Asia/Shanghai

# ---- 数据库 ----
# 开发默认 SQLite；生产改为 PostgreSQL：
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/gdcalendar
DATABASE_URL=sqlite+aiosqlite:///./data/gd_calendar.db

# ---- 抓取 ----
HTTP_TIMEOUT=30
HTTP_RETRIES=3
RATE_LIMIT_SECONDS=3.0          # 单域名最小间隔
DOUBAN_CRAWL_DELAY=5.0          # 豆瓣 robots 声明的 Crawl-delay
USER_AGENT=GDLiveCalendarBot/0.1 (+https://example.com/gd-calendar; contact: you@example.com)
BROWSER_HEADLESS=true
BROWSER_WIDTH=1440
BROWSER_HEIGHT=2200
BROWSER_WAIT_SECONDS=6.0

# ---- 视觉抽取（截图分析兜底）----
# 单图 <=384 tokens，与 V4-Flash 同价
VISION_ENABLED=false
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# ---- 调度 ----
SCHEDULER_ENABLED=true
FETCH_HTTP_INTERVAL_HOURS=6
FETCH_BROWSER_INTERVAL_HOURS=12
FETCH_VENUE_INTERVAL_HOURS=12
REFRESH_STATUS_INTERVAL_HOURS=12

# ---- 页面功能开关 ----
# 关掉后前端隐藏对应入口；API 仍然存在，脚本与接口调用不受影响。
# 前端 js/features.js 里有一份静态兜底值，保证后端不可用时开关依然生效。
FEATURE_ICS=false                # 「＋ 订阅这个日历」与「加进我的日历 (.ics)」
FEATURE_UPDATE=false             # 页面上的「↻ 更新数据」按钮

# ---- 范围 ----
# 只采未来 N 天
FUTURE_WINDOW_DAYS=90
# 启用的城市（对应采集器里的城市码表）
ENABLED_CITIES=广州,深圳,佛山,东莞,珠海,中山,惠州,汕头
