# 环境与密钥
.env
*.env
!.env.example

# 数据（数据库 / 快照 / 截图）
# ⚠️ 只忽略数据库与抓取快照；`docs/data/*.json` 是静态站的数据，**必须提交**
data/*.db
data/*.db-shm
data/*.db-wal
data/snapshots/
data/shots/
data/posters/

# 临时截图（CDP 验证产物）
app/web/_*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 提交信息草稿（脚本生成，不进版本库）
.git-commit-msg.txt

# GitHub Actions workflow：当前 gh token 缺 workflow scope，无法推送。
# 需要时手动在网页上传，或 gh auth refresh -s workflow 后移除本行。
.github/workflows/

# 小红书采集结果（每次采集都变，且与维护者账号相关）
data/xhs_notes.json
data/xhs_leads.md
data/xhs_artist_accounts.json
data/xhs_test.json
# 浏览器 profile / cookie 导出（实际落在仓库外的 %LOCALAPPDATA%，这里兜底）
xhs-profile/
xhs-cookies.json
# 小红书抓取的图片素材（体积大 ~1.7MB；数据已转录进 gz_idol_roster.py，
# 图片可重新抓取，所以不进版本库）
# ⚠️ 用通配 `data/xhs_note*` 覆盖所有变体，避免每加一个新目录就漏一次
data/xhs_note*/
data/xhs_images/
